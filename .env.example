# Copy to .env.local. Never commit real credentials.
# Development default only; production must explicitly configure its HTTP(S) origin.
# Supply only scheme/host/port, without credentials, path, query or fragment.
APP_ORIGIN=http://localhost:3000
# Required for authentication, workspaces, and invitation storage.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=makemymarriage_dev
LOG_LEVEL=info

# Invitation emails: configure both locally and in Vercel Production, then redeploy.
# Sender must use a domain you own and have verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Set APP_ORIGIN=https://makemymarriage.vercel.app in Vercel Production.
# Missing email settings produce a visible failure; the invite link remains shareable.
